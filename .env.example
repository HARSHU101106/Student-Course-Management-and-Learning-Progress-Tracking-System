# Used by docker-compose.yml (copy to .env and fill in). Never commit the real .env.
JWT_SECRET=
AI_SERVICE_TOKEN=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Public URL of the web app (CORS + Socket.IO allow-list)
CLIENT_URL=http://localhost:8080
# Optional
LLM_PROVIDER=offline
LLM_API_KEY=
YOUTUBE_API_KEY=
SEED_ON_BOOT=true
SEED_DEMO_USERS=false
