# AdaptLearn AI service (FastAPI + LangGraph)
ENVIRONMENT=development                 # development | test | production
AI_SERVICE_TOKEN=change-me-to-a-long-random-string-24+   # must equal the API's AI_SERVICE_TOKEN

# Persist the retrieval index in the same MongoDB as the API (empty = in-memory, lost on restart)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=adaptlearn

# Generation: offline (default, no key, deterministic) | openai | azure
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# AZURE_OPENAI_API_VERSION=2024-06-01

# Retrieval
TOP_K=4
MIN_RETRIEVAL_SCORE=0.12                # see docs/evaluation-results.md before changing
