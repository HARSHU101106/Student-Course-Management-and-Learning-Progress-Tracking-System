NODE_ENV=development
PORT=5000

# Required
MONGO_URI=mongodb://127.0.0.1:27017/adaptlearn
JWT_SECRET=replace-with-at-least-32-random-bytes   # e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

# Browser origin(s) allowed by CORS and Socket.IO (comma separated, no trailing slash)
CLIENT_URL=http://localhost:5173

# Token lifetime and password hashing cost
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# Creates (once) the administrator account at boot. Password: 12-72 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# AI service (optional: without it the tutor/planner/AI quiz return 503 and everything else works)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=must-match-the-ai-service-token-24+chars

# Optional: YouTube Data API key (without it Course Studio uses the public playlist feed)
YOUTUBE_API_KEY=

# Behind a reverse proxy (Render, nginx): number of proxy hops to trust for client IPs
TRUST_PROXY=1

# Rate limits (requests per window)
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=30

# First deploy only: create the demo catalogue (and, with SEED_DEMO_USERS, two demo students)
SEED_ON_BOOT=false
SEED_DEMO_USERS=false
